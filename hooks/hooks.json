{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DONT_FORGET_HOOKS:-1}\" = 0 ] || python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/hot-scan.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DONT_FORGET_HOOKS:-1}\" = 0 ] || python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/context-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
